<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- NuGet Package Metadata -->
    <PackageId>TheMediatR</PackageId>
    <Version>1.0.0</Version>
    <Authors>MusaZaidi110</Authors>
    <Company>Your Company</Company>
    <Description>A lightweight, high-performance mediator implementation for .NET. Supports request/response and notification patterns with minimal overhead.</Description>
    <PackageTags>mediator;cqrs;messaging;request-response;notifications</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/MusaZaidi110/TheMediatR</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MusaZaidi110/TheMediatR</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Assembly Info -->
    <AssemblyName>TheMediatR</AssemblyName>
    <RootNamespace>TheMediatR</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" Condition="Exists('..\README.md')" />
  </ItemGroup>

</Project>
