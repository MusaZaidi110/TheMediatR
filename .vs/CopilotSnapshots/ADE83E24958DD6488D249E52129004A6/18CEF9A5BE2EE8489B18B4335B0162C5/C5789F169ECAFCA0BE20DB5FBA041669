using MediatR.CustomMediatR;
using MediatR.Features;
using Microsoft.AspNetCore.Mvc;

namespace MediatR.Features
{
    public static class GetAllGames
    {
        public record Query : IRequest<List<string>>;

        public class Handler : IRequestHandler<Query, List<string>>
        {
            public Task<List<string>> Handle(Query request, CancellationToken cancellationToken)
            {
                var games = new List<string> { "Game 1", "Game 2", "Game 3", "Game 4", "Game 5" };
                return Task.FromResult(games);
            }
        }
    }

    public record UserCreatedNotification(string UserId, string Email) : INotification;


    public class EmailHandler : INotificationHandler<UserCreatedNotification>
    {
        public Task Handle(UserCreatedNotification notification, CancellationToken cancellationToken)
        {
            Console.WriteLine($"Sending email to {notification.Email}");
            return Task.CompletedTask;
        }
    }

    public class AuditHandler : INotificationHandler<UserCreatedNotification>
    {
        public Task Handle(UserCreatedNotification notification, CancellationToken cancellationToken)
        {
            Console.WriteLine($"Auditing user creation for {notification.UserId}");
            return Task.CompletedTask;
        }
    }
}


[ApiController]
[Route("api/[controller]")]

public class GamesController(ISender sender, IPublisher puslish) : ControllerBase
{
    [HttpGet]
    public async Task<IActionResult> GetAllGames(CancellationToken cancellationToken)
    {
        var games = await sender.Send(new GetAllGames.Query(), cancellationToken);
        return Ok(games);
    }

    [HttpPost]
    public async Task<IActionResult> AddGames(CancellationToken cancellationToken)
    {
        await puslish.Publish(new UserCreatedNotification("123", "test@example.com"), cancellationToken);
        return Ok();
    }
}