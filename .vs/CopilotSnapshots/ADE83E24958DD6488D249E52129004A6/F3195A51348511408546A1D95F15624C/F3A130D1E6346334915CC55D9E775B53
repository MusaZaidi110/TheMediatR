namespace MediatR.CustomMediatR
{
    /// <summary>
    /// Default implementation that delegates to ISender and IPublisher.
    /// </summary>
    public sealed class Mediator(ISender sender, IPublisher publisher) : IMediator
    {
        public Task<TResponse> Send<TResponse>(IRequest<TResponse> request, CancellationToken cancellationToken = default)
            => sender.Send(request, cancellationToken);

        public Task Publish<TNotification>(TNotification notification, CancellationToken cancellationToken = default)
            where TNotification : INotification
            => publisher.Publish(notification, cancellationToken);
    }
}
